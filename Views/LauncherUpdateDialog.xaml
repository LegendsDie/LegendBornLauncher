<Window x:Class="LegendBorn.Views.LauncherUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление LegendBorn"
        Width="520"
        Height="342"
        MinWidth="520"
        MaxWidth="520"
        MinHeight="342"
        MaxHeight="342"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="UpdateGhostButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#D9DCEC"/>
            <Setter Property="Background" Value="#141828"/>
            <Setter Property="BorderBrush" Value="#3C3556"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#1B2034"/>
                                <Setter TargetName="Body" Property="BorderBrush" Value="#694B8E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdatePrimaryButton" TargetType="Button" BasedOn="{StaticResource UpdateGhostButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7644B7"/>
            <Setter Property="BorderBrush" Value="#9B69D8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#8750C9"/>
                                <Setter TargetName="Body" Property="BorderBrush" Value="#B67BEF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#252A3C"/>
            <Setter Property="Foreground" Value="#9B5BDB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" Background="Transparent" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="20"
            Background="#F50B0E19"
            BorderBrush="#6B3A91"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#71121627"
                    BorderBrush="#332743"
                    BorderThickness="0,0,0,1"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="9" Background="#2A1B43" BorderBrush="#734DA2" BorderThickness="1">
                        <TextBlock Text="✦" Foreground="#D9BFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="LEGENDBORN" Foreground="#EDF0FF" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Обновление лаунчера" Foreground="#7F8BA3" FontSize="9"/>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Grid.Column="3"
                            Width="30" Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#B8C0D2"
                            FontSize="17"
                            Content="×"
                            Cursor="Hand"
                            Click="CloseButton_OnClick"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,18,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleText"
                           Foreground="#F2F3FF"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Доступно обновление"/>

                <TextBlock x:Name="MessageText"
                           Grid.Row="2"
                           Foreground="#9CA7BD"
                           FontSize="11"
                           TextWrapping="Wrap"
                           LineHeight="17"/>

                <Border Grid.Row="4"
                        Background="#67101422"
                        BorderBrush="#342D48"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ВЕРСИЯ" Foreground="#748098" FontSize="8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock x:Name="CurrentVersionText" Foreground="#A5AEC0" FontSize="12"/>
                                <TextBlock Text="  →  " Foreground="#745595" FontSize="12"/>
                                <TextBlock x:Name="TargetVersionText" Foreground="#DAB8FF" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="КАНАЛ" Foreground="#748098" FontSize="8" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="SourceText" Margin="0,3,0,0" Foreground="#ABB5C8" FontSize="10" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="ProgressArea" Grid.Row="6" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressStatusText" Foreground="#9EA9BF" FontSize="10" Text="Загрузка обновления…"/>
                        <TextBlock x:Name="ProgressPercentText" Grid.Column="1" Foreground="#D9B6FF" FontSize="10" Text="0%"/>
                    </Grid>
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Grid.Row="2"
                                 Minimum="0" Maximum="100" Value="0"
                                 Style="{StaticResource UpdateProgressStyle}"/>
                </Grid>

                <StackPanel x:Name="ActionButtons"
                            Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            Style="{StaticResource UpdateGhostButton}"
                            Content="Позже"
                            Margin="0,0,9,0"
                            Click="SecondaryButton_OnClick"/>
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource UpdatePrimaryButton}"
                            Content="Обновить"
                            Click="PrimaryButton_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
