<UserControl x:Class="LegendBorn.Views.Tabs.StartTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LegendBorn.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="DashboardPanel" TargetType="Border">
            <Setter Property="Background" Value="#BC0B0E19"/>
            <Setter Property="BorderBrush" Value="#39324F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="DashboardDim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8995AB"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="CarouselArrow" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource ScreenFrameStyle}">
            <Grid>
                <Image Source="pack://application:,,,/Resources/Assets/legendcraft.jpg"
                       Stretch="UniformToFill"
                       Opacity="0.27"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Rectangle Fill="#A9080A14"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EF0B0C1B" Offset="0"/>
                            <GradientStop Color="#C90C0D1C" Offset="0.48"/>
                            <GradientStop Color="#9A090B15" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="24,20,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="166"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <Border HorizontalAlignment="Left"
                                    Padding="9,4"
                                    CornerRadius="10"
                                    Background="#24163B"
                                    BorderBrush="#5A3B7B"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#7BF1A8" VerticalAlignment="Center"/>
                                    <TextBlock Margin="7,0,0,0"
                                               Text="ОФИЦИАЛЬНАЯ СБОРКА"
                                               Foreground="#CBB6F5"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding PackName}"
                                       Foreground="{StaticResource TextStrongLocal}"
                                       FontSize="31"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding BuildDisplayName}"
                                       Foreground="#AAB5CA"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Margin="12,0,0,0"
                                CornerRadius="18"
                                Background="#2A0B0D19"
                                BorderBrush="#302343"
                                BorderThickness="1">
                            <Image Source="pack://application:,,,/Resources/Assets/legendcraft.png"
                                   Height="126"
                                   MaxWidth="280"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect Color="#A85CFF"
                                                      BlurRadius="24"
                                                      ShadowDepth="0"
                                                      Opacity="0.28"/>
                                </Image.Effect>
                            </Image>
                        </Border>
                    </Grid>

                    <Border Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="2"
                            Style="{StaticResource DashboardPanel}"
                            BorderBrush="#513076"
                            Background="#D00A0C18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ТЕКУЩИЙ СКИН" Style="{StaticResource DashboardDim}"/>
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding SelectedSkinTitle}"
                                               Foreground="#E5D9FA"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Height="28"
                                        Padding="9,0"
                                        Content="Сменить"
                                        Command="{Binding OpenSkinManagerCommand}"/>
                            </Grid>

                            <Border Grid.Row="2"
                                    CornerRadius="14"
                                    Background="#65080A13"
                                    BorderBrush="#37244E"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <controls:Skin3DView x:Name="Skin3DPreview"/>
                            </Border>

                            <TextBlock Grid.Row="4"
                                       HorizontalAlignment="Center"
                                       Text="3D · синхронизировано с профилем"
                                       Foreground="#6F7C94"
                                       FontSize="9"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource DashboardPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ТВОЙ НИК" Style="{StaticResource DashboardDim}"/>
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding Username}"
                                           Foreground="#F0EBFA"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding SelectedServer.Name, StringFormat=сервер · {0}}"
                                           Foreground="#747F96"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="#252A3E"/>

                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DashboardFriendsTitle"
                                               Text="Друзья на сервере"
                                               Foreground="#CCD4E4"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <TextBlock Grid.Column="1"
                                               Text="обновляется автоматически"
                                               Foreground="#68758D"
                                               FontSize="9"/>
                                </Grid>

                                <ItemsControl x:Name="DashboardFriendsList" Grid.Row="2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,8,0"
                                                    Padding="9"
                                                    CornerRadius="11"
                                                    Background="#78101422"
                                                    BorderBrush="#2D334A"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="10" ClipToBounds="True"
                                                            Background="#202943" BorderBrush="#3E4564" BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#E9E4F4"
                                                                       FontWeight="Bold"/>
                                                            <Image Source="{Binding AvatarUrl, IsAsync=True}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="#E3E8F3"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding PresenceText}"
                                                                   Foreground="#7F8CA4"
                                                                   FontSize="9"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="DashboardFriendsEmpty"
                                           Grid.Row="2"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"
                                           Text="Пока нет данных об активности друзей."
                                           Foreground="#77839A"
                                           FontSize="10"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Style="{StaticResource DashboardPanel}"
                            Padding="15,13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Последние новости"
                                               Foreground="#E9EDF6"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="NewsPageText"
                                               Margin="10,1,0,0"
                                               Text=""
                                               Foreground="#69768E"
                                               FontSize="9"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="NewsPrevButton"
                                            Style="{StaticResource CarouselArrow}"
                                            Content="&#xE76B;"
                                            ToolTip="Предыдущие новости"
                                            Click="NewsPrev_OnClick"/>
                                    <Button x:Name="NewsNextButton"
                                            Style="{StaticResource CarouselArrow}"
                                            Margin="7,0,0,0"
                                            Content="&#xE76C;"
                                            ToolTip="Следующие новости"
                                            Click="NewsNext_OnClick"/>
                                    <Button Style="{StaticResource GhostButton}"
                                            Margin="9,0,0,0"
                                            Height="34"
                                            Padding="11,0"
                                            Content="Все"
                                            Click="OpenNewsTab_OnClick"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl x:Name="NewsCarouselItems" Grid.Row="2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NewsCardButtonStyle}"
                                                Margin="0,0,10,0"
                                                Tag="{Binding Url}"
                                                Click="OpenNewsItem_OnClick">
                                            <Border Background="#76101421"
                                                    BorderBrush="#30364D"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="11">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="5"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="#E1E6F1"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   Text="{Binding Date}"
                                                                   Foreground="#68758D"
                                                                   FontSize="8"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding Summary}"
                                                               Foreground="#8793A9"
                                                               FontSize="9"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="34"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NewsEmptyText"
                                       Grid.Row="2"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Text="Новости пока недоступны — здесь не будут показываться выдуманные карточки."
                                       Foreground="#728097"
                                       FontSize="10"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Background="#E50A0D18"
                            BorderBrush="#493062"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="#D5DBEA"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                                               Foreground="#BFA2F2"
                                               FontSize="9"/>
                                </Grid>
                                <ProgressBar x:Name="PackProgressBar"
                                             Margin="0,6,0,0"
                                             Height="7"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}"
                                        Height="48"
                                        Padding="12,0"
                                        ToolTip="Открыть папку игры"
                                        Command="{Binding OpenGameDirCommand}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource PlayOrStopButtonStyle}"
                                        Click="PlayOrStop_OnClick"
                                        Margin="9,0,0,0"
                                        MinWidth="180"
                                        Height="48"
                                        FontSize="14"
                                        Padding="28,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
