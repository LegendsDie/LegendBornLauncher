<UserControl x:Class="LegendBorn.Views.Tabs.ProfileTabView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1180"
             Focusable="False">

    <UserControl.Resources>
        <Style x:Key="ProfileHubCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ProfileHubSubCard" TargetType="Border">
            <Setter Property="Background" Value="#13000000"/>
            <Setter Property="BorderBrush" Value="#2A2F49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="ProfileHubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimLocal}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="ProfileHubValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ProfileHubTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="Background" Value="#12000000"/>
            <Setter Property="BorderBrush" Value="#333952"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextStrongLocal}"/>
        </Style>

        <Style x:Key="ProfileHubListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="#10000000"
                                BorderBrush="#292F47"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeGlow}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#19000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OnlineDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#6B7280"/>
            <Setter Property="Stroke" Value="#151821"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter Property="Fill" Value="#34D399"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource ProfileHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="68" Height="68" CornerRadius="22" ClipToBounds="True" Background="#202943">
                    <Grid>
                        <Rectangle Fill="{StaticResource SoftCardGlowBrush}"/>
                        <TextBlock Text="{Binding UserInitial}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextStrongLocal}"
                                   FontSize="20" FontWeight="Bold"/>
                        <Image Source="{Binding AvatarUrl, IsAsync=True}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SiteUserName}" Foreground="{StaticResource TextStrongLocal}"
                                   FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <Border Margin="10,2,0,0" Padding="9,3" CornerRadius="99"
                                Background="#15281F" BorderBrush="#2D6A57" BorderThickness="1">
                            <TextBlock Text="ONLINE" Foreground="#86EFAC" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource ProfileHubLabel}" Text="Minecraft: "/>
                        <TextBlock Foreground="{StaticResource TextStrongLocal}" Text="{Binding Username}"/>
                        <TextBlock Margin="18,0,0,0" Style="{StaticResource ProfileHubLabel}" Text="Резонит: "/>
                        <TextBlock Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold"
                                   Text="{Binding Rezonite, StringFormat={}{0:N0}}"/>
                        <TextBlock Margin="18,0,0,0" Style="{StaticResource ProfileHubLabel}" Text="Клан: "/>
                        <TextBlock Foreground="{StaticResource TextStrongLocal}" Text="{Binding ClanName}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                            Content="Обновить всё" Command="{Binding RefreshProfileExperienceCommand}"/>
                    <Button Style="{StaticResource GhostButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                            Content="Профиль на сайте" Click="OpenSite_OnClick"/>
                    <Button Style="{StaticResource DangerButton}" Height="36" Padding="14,0"
                            Content="Выйти" Click="Logout_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: account, progression, skin, clan -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource ProfileHubCard}">
                        <StackPanel>
                            <TextBlock Text="Прогресс" Style="{StaticResource SectionHeaderText}"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ProfileHubSubCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ProfileHubLabel}" Text="УРОВЕНЬ"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="28" FontWeight="Bold"
                                                   Foreground="{StaticResource TextStrongLocal}" Text="{Binding ProfileLevel}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource ProfileHubSubCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ProfileHubLabel}" Text="ВСЕГО XP"/>
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource ProfileHubValue}"
                                                   Text="{Binding ProfileXpTotal, StringFormat={}{0:N0}}"/>
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource ProfileHubLabel}"
                                                   Text="{Binding ProfileXpLevelText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource ProfileHubSubCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ProfileHubLabel}" Text="XP СЕЗОНА"/>
                                        <TextBlock Margin="0,6,0,0" Style="{StaticResource ProfileHubValue}"
                                                   Text="{Binding ProfileXpSeason, StringFormat={}{0:N0}}"/>
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource ProfileHubLabel}"
                                                   Text="Сезонная активность"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ProgressBar Margin="0,14,0,0" Height="7" Minimum="0" Maximum="100"
                                         Value="{Binding ProfileXpProgressPercent}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ProfileHubCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Minecraft и скин" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource ProfileHubLabel}"
                                               Text="Выбранный сервером образ и локальная геометрия рук — разные настройки."/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="34" Padding="13,0"
                                        Content="Выбрать / сменить" Command="{Binding OpenSkinManagerCommand}"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="126"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Height="154" CornerRadius="14" ClipToBounds="True"
                                        Background="#111522" BorderBrush="#303651" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Нет превью" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDimLocal}"/>
                                        <Image Source="{Binding SkinPreviewUrl, IsAsync=True}" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ProfileHubLabel}" Text="ТЕКУЩИЙ ОБРАЗ"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource ProfileHubValue}"
                                               FontSize="17" Text="{Binding SelectedSkinTitle}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource ProfileHubLabel}"
                                               Text="{Binding SelectedSkinKey, StringFormat=Ключ: {0}}"/>
                                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDimLocal}" Text="{Binding SkinStatusText}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Style="{StaticResource ProfileHubLabel}" Text="Модель рук"/>
                                        <ComboBox Width="150" Height="32" SelectedValue="{Binding SkinModel, Mode=TwoWay}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Обычная" Tag="Raw"/>
                                            <ComboBoxItem Content="Тонкая" Tag="Slim"/>
                                        </ComboBox>
                                        <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Height="32" Padding="12,0"
                                                Content="Сохранить" Command="{Binding SaveSkinModelCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ProfileHubCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Клан" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource ProfileHubLabel}"
                                               Text="Клан теперь можно просматривать, находить и менять прямо из лаунчера."/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDimLocal}"
                                           Text="{Binding ClanStatusText}" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </Grid>

                            <Border Margin="0,14,0,0" Style="{StaticResource ProfileHubSubCard}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ProfileHubSubCard}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasClan}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="14" Background="#222943" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding ClanTag}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextStrongLocal}" FontWeight="Bold"/>
                                                <Image Source="{Binding ClanAvatarUrl, IsAsync=True}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource ProfileHubValue}" FontSize="16" Text="{Binding ClanName}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Style="{StaticResource ProfileHubLabel}" Text="{Binding ClanRoleText}"/>
                                                <TextBlock Margin="12,0,0,0" Style="{StaticResource ProfileHubLabel}"
                                                           Text="{Binding ClanMemberCount, StringFormat={}{0} участников}"/>
                                                <TextBlock Margin="12,0,0,0" Style="{StaticResource ProfileHubLabel}"
                                                           Text="{Binding ClanTreasury, StringFormat=Казна: {0:N0}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="3" Style="{StaticResource DangerButton}" Height="32" Padding="12,0"
                                                Content="Покинуть" Command="{Binding LeaveClanCommand}"/>
                                    </Grid>

                                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ClanMembers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource ProfileHubLabel}" Text="{Binding PresenceText}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ProfileHubLabel}" Text="{Binding RoleText}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,14,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasClan}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ProfileHubTextBox}" Text="{Binding ClanSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Название или тег клана"/>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="36" Padding="14,0"
                                            Content="Найти" Command="{Binding SearchClansCommand}"/>
                                </Grid>
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ClanSearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7" Style="{StaticResource ProfileHubSubCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource ProfileHubValue}" Text="{Binding DisplayName}"/>
                                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource ProfileHubLabel}" Text="{Binding MembersText}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="32" Padding="12,0"
                                                            Content="Вступить"
                                                            Command="{Binding DataContext.JoinClanCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: friends and requests -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource ProfileHubCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Друзья" Style="{StaticResource SectionHeaderText}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource ProfileHubLabel}"
                                               Text="{Binding FriendsCount, StringFormat={}{0} друзей}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDimLocal}"
                                           Text="{Binding SocialStatusText}" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource ProfileHubTextBox}"
                                         Text="{Binding FriendSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Поиск в списке друзей"/>
                                <TextBox Grid.Column="2" Style="{StaticResource ProfileHubTextBox}"
                                         Text="{Binding FriendRequestQuery, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Ник или ID пользователя"/>
                                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Height="36" Padding="13,0"
                                        Content="Добавить" Command="{Binding SendFriendRequestCommand}"/>
                            </Grid>

                            <ListBox Margin="0,12,0,0" MaxHeight="360"
                                     Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding FilteredFriends}"
                                     ItemContainerStyle="{StaticResource ProfileHubListItem}"
                                     MouseDoubleClick="FriendsList_OnMouseDoubleClick"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="13" Background="#202943" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextStrongLocal}" FontWeight="Bold"/>
                                                    <Image Source="{Binding AvatarUrl, IsAsync=True}" Stretch="UniformToFill"/>
                                                    <Ellipse Style="{StaticResource OnlineDot}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{StaticResource ProfileHubLabel}" Text="{Binding PresenceText}"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Height="30" Padding="10,0"
                                                    Content="Удалить"
                                                    Command="{Binding DataContext.RemoveFriendCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ProfileHubCard}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Заявки в друзья" Style="{StaticResource SectionHeaderText}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ProfileHubLabel}" Text="Входящие: "/>
                                    <TextBlock Foreground="{StaticResource TextStrongLocal}" Text="{Binding IncomingFriendRequestCount}"/>
                                    <TextBlock Margin="12,0,0,0" Style="{StaticResource ProfileHubLabel}" Text="Исходящие: "/>
                                    <TextBlock Foreground="{StaticResource TextStrongLocal}" Text="{Binding OutgoingFriendRequestCount}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,14,0,8" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" Text="Входящие"/>
                            <ItemsControl ItemsSource="{Binding IncomingFriendRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,7" Style="{StaticResource ProfileHubSubCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ProfileHubValue}" Text="{Binding Name}"/>
                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource ProfileHubLabel}"
                                                               Text="{Binding PublicId, StringFormat=ID: {0}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource GhostButton}" Height="30" Padding="10,0" Margin="0,0,7,0"
                                                            Content="Принять"
                                                            Command="{Binding DataContext.AcceptFriendRequestCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource DangerButton}" Height="30" Padding="10,0"
                                                            Content="Отклонить"
                                                            Command="{Binding DataContext.DeclineFriendRequestCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,12,0,8" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" Text="Исходящие"/>
                            <ItemsControl ItemsSource="{Binding OutgoingFriendRequests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,7" Style="{StaticResource ProfileHubSubCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource ProfileHubValue}" Text="{Binding Name}"/>
                                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource ProfileHubLabel}" Text="Ожидает ответа"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#A78BFA" Text="ОТПРАВЛЕНО" FontSize="10"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
