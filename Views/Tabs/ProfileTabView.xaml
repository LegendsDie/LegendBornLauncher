<UserControl x:Class="LegendBorn.Views.Tabs.ProfileTabView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LegendBorn.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="HubCard" TargetType="Border">
            <Setter Property="Background" Value="#B80C0F1D"/>
            <Setter Property="BorderBrush" Value="#352F2450"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="HubSubCard" TargetType="Border">
            <Setter Property="Background" Value="#8C101421"/>
            <Setter Property="BorderBrush" Value="#2E344D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource HubSubCard}">
            <Setter Property="MinHeight" Value="76"/>
        </Style>

        <Style x:Key="HubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8490A8"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="HubValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HubInput" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="Background" Value="#A70B0E18"/>
            <Setter Property="BorderBrush" Value="#353A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextStrongLocal}"/>
        </Style>

        <Style x:Key="HubListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#71101522"
                                BorderBrush="#2D334A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#A3161A2A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#6A4A8C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9C6CE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Launcher-styled scrollbar: no system-white track/thumb. -->
        <Style x:Key="ProfileScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody"
                                Margin="2,1"
                                CornerRadius="4"
                                Background="#68459A"
                                BorderBrush="#8D63C8"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#8459BF"/>
                                <Setter TargetName="ThumbBody" Property="BorderBrush" Value="#B783FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="#9C68E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#38101822"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ProfileScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ProfileScrollBar}"/>

        <Style x:Key="ProfileTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8F99AE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#55101421"
                                BorderBrush="#2E344D"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6A4A8C"/>
                                <Setter Property="Foreground" Value="#D7C9EF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#8A24183A"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8F5FC5"/>
                                <Setter Property="Foreground" Value="#F0E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileTabs" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <ContentPresenter Grid.Row="2"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="True"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveBadge" TargetType="Border">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#2C1820"/>
            <Setter Property="BorderBrush" Value="#643447"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Profile.MinecraftStatus.Online}" Value="True">
                    <Setter Property="Background" Value="#14281F"/>
                    <Setter Property="BorderBrush" Value="#2F6655"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Account hero + progression. -->
        <Border Grid.Row="0"
                CornerRadius="17"
                BorderBrush="#4C2D72"
                BorderThickness="1"
                Padding="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#16142D" Offset="0"/>
                    <GradientStop Color="#111427" Offset="0.58"/>
                    <GradientStop Color="#0E1120" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.95*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="70" Height="70"
                        CornerRadius="20"
                        ClipToBounds="True"
                        Background="#211B39"
                        BorderBrush="#6B3FA0"
                        BorderThickness="1">
                    <Grid>
                        <TextBlock Text="{Binding UserInitial}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextStrongLocal}"
                                   FontSize="21"
                                   FontWeight="Bold"/>
                        <Image Source="{Binding AvatarUrl, IsAsync=True}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SiteUserName}"
                                   Foreground="{StaticResource TextStrongLocal}"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Margin="10,3,0,0"
                                Padding="8,2"
                                CornerRadius="10"
                                Background="#14281F"
                                BorderBrush="#2F6655"
                                BorderThickness="1">
                            <TextBlock Text="ONLINE" Foreground="#86EFAC" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <WrapPanel Margin="0,8,0,0">
                        <Border Padding="8,4" Margin="0,0,7,0" CornerRadius="9" Background="#70111624" BorderBrush="#303650" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource HubLabel}" Text="MC  "/>
                                <TextBlock Foreground="{StaticResource TextStrongLocal}" FontSize="11" Text="{Binding Username}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="8,4" Margin="0,0,7,0" CornerRadius="9" Background="#70111624" BorderBrush="#303650" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource HubLabel}" Text="РЕЗОН  "/>
                                <TextBlock Foreground="#CBB4FF" FontSize="11" FontWeight="SemiBold"
                                           Text="{Binding Rezonite, StringFormat={}{0:N0}}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="8,4" CornerRadius="9" Background="#70111624" BorderBrush="#303650" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource HubLabel}" Text="КЛАН  "/>
                                <TextBlock Foreground="{StaticResource TextStrongLocal}" FontSize="11" Text="{Binding ClanName}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Progress moved into the visible profile header. -->
                <Border Grid.Column="4"
                        VerticalAlignment="Stretch"
                        Background="#65101421"
                        BorderBrush="#4B3B68"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="12,9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Padding="8,3" CornerRadius="9" Background="#472F6C" BorderBrush="#704AA0" BorderThickness="1">
                                <TextBlock Foreground="#F0E5FF" FontSize="10" FontWeight="Bold"
                                           Text="{Binding ProfileLevel, StringFormat=УРОВЕНЬ {0}}"/>
                            </Border>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource HubLabel}"
                                       Text="{Binding ProfileXpLevelText}"/>
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#CBB4FF" FontSize="10"
                                       Text="{Binding ProfileXpTotal, StringFormat={}{0:N0} XP}"/>
                        </Grid>
                        <ProgressBar x:Name="ProfileXpProgressBar"
                                     Grid.Row="2"
                                     Height="7"
                                     Minimum="0"
                                     Maximum="100"/>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource HubLabel}" Text="ПРОГРЕСС LEGEND BORN"/>
                            <TextBlock Grid.Column="1" Foreground="#A58ACF" FontSize="10"
                                       Text="{Binding ProfileXpSeason, StringFormat=Сезон: {0:N0} XP}"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Height="34" Padding="13,0" Margin="0,0,7,0"
                            Content="Обновить" Command="{Binding RefreshProfileExperienceCommand}"/>
                    <Button Style="{StaticResource GhostButton}" Height="34" Padding="13,0" Margin="0,0,7,0"
                            Content="Сайт" Click="OpenSite_OnClick"/>
                    <Button Style="{StaticResource DangerButton}" Height="34" Padding="13,0"
                            Content="Выйти" Click="Logout_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource ProfileTabs}" SelectedIndex="0">
            <!-- STATUS -->
            <TabItem Header="Статус" Style="{StaticResource ProfileTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,5,0">
                        <Border Style="{StaticResource HubCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="0.85*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Сервер" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="0,4,0,8" Style="{StaticResource HubLabel}"
                                               Text="Профиль статуса привязан к игровому серверу."/>
                                    <ComboBox Height="42"
                                              ItemsSource="{Binding Servers}"
                                              SelectedItem="{Binding SelectedServer}"
                                              IsEnabled="False"/>
                                    <TextBlock Margin="2,6,0,0" Style="{StaticResource HubLabel}"
                                               Text="Сейчас сервер один — выбор откроется при добавлении следующего."/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource HubLabel}" Text="LIVE STATUS"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}"
                                               Text="{Binding Profile.MinecraftStatus.ServerIdText, TargetNullValue=—}"/>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource HubLabel}"
                                               Text="{Binding Profile.MinecraftStatus.UpdatedText, TargetNullValue=Нет данных от сервера}"/>
                                </StackPanel>

                                <Border Grid.Column="3" Style="{StaticResource LiveBadge}" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="НЕТ ДАННЫХ"/>
                                                <Setter Property="Foreground" Value="#BFA6B0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Profile.MinecraftStatus.Online}" Value="False">
                                                        <Setter Property="Text" Value="НЕ В ИГРЕ"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Profile.MinecraftStatus.Online}" Value="True">
                                                        <Setter Property="Text" Value="В ИГРЕ"/>
                                                        <Setter Property="Foreground" Value="#86EFAC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.88*" MinWidth="300"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.12*" MinWidth="390"/>
                            </Grid.ColumnDefinitions>

                            <!-- Real 3D Minecraft skin, not a flat preview atlas. -->
                            <Border Grid.Column="0" Style="{StaticResource HubCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="330"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Текущий образ" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource HubLabel}"
                                                       Text="{Binding SelectedSkinTitle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="32" Padding="12,0"
                                                Content="Сменить скин" Command="{Binding OpenSkinManagerCommand}"/>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Background="#090B14"
                                            BorderBrush="#3A2A52"
                                            BorderThickness="1"
                                            CornerRadius="15"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Ellipse Width="210" Height="52" VerticalAlignment="Bottom" Margin="0,0,0,20" Fill="#251A3C"/>
                                            <controls:Skin3DView x:Name="ProfileSkin3DPreview"
                                                                 SkinUrl="{Binding Profile.Minecraft.SelectedSkin.SkinUrl}"
                                                                 Margin="8"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource HubLabel}" Text="Зажми и потяни мышью, чтобы повернуть."/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource HubLabel}" Foreground="#A98DCD"
                                                   Text="2-й слой скина включён"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource HubCard}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Характеристики" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource HubLabel}"
                                                           Text="Живые данные приходят от LegendStory через серверный heartbeat."/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#846AA7" FontSize="10"
                                                       Text="{Binding Profile.MinecraftStatus.UpdatedText, TargetNullValue=Ожидание данных}"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="9"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="9"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="9"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Style="{StaticResource MetricCard}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubLabel}" Text="МИР"/>
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}"
                                                               Text="{Binding Profile.MinecraftStatus.WorldText, TargetNullValue=—}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubLabel}" Text="КООРДИНАТЫ"/>
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" FontSize="12"
                                                               Text="{Binding Profile.MinecraftStatus.CoordinatesText, TargetNullValue=—}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="2" Style="{StaticResource MetricCard}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubLabel}" Text="ЗДОРОВЬЕ"/>
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Foreground="#F3A6B3"
                                                               Text="{Binding Profile.MinecraftStatus.HealthText, TargetNullValue=—}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MetricCard}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubLabel}" Text="ГОЛОД"/>
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Foreground="#E6C47A"
                                                               Text="{Binding Profile.MinecraftStatus.FoodText, TargetNullValue=—}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="4" Style="{StaticResource MetricCard}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubLabel}" Text="ОПЫТ В MINECRAFT"/>
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Foreground="#A8E6A3"
                                                               Text="{Binding Profile.MinecraftStatus.ExperienceText, TargetNullValue=—}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource MetricCard}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubLabel}" Text="ТЕКУЩАЯ СЕССИЯ"/>
                                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}"
                                                               Text="{Binding Profile.MinecraftStatus.SessionText, TargetNullValue=—}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource HubCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Minecraft-профиль" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Margin="0,5,0,0" Foreground="#BAC4D7" FontSize="12"
                                                       Text="{Binding Username}"/>
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource HubLabel}"
                                                       Text="{Binding SkinStatusText}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#A98DCD" FontSize="10"
                                                   Text="{Binding SelectedSkinKey, StringFormat=SKIN {0}}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- COMMUNITY -->
            <TabItem Header="Сообщество" Style="{StaticResource ProfileTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <Grid Margin="0,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.82*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.18*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Clan -->
                            <Border Style="{StaticResource HubCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Клан" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource HubLabel}"
                                                       Text="Состав, поиск и вступление прямо в Launcher."/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#8E99AE" FontSize="10"
                                                   Text="{Binding ClanStatusText}" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <Border Margin="0,12,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource HubSubCard}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasClan}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource HubValue}" FontSize="16" Text="{Binding ClanName}"/>
                                                    <WrapPanel Margin="0,3,0,0">
                                                        <TextBlock Style="{StaticResource HubLabel}" Text="{Binding ClanTag}"/>
                                                        <TextBlock Margin="10,0,0,0" Style="{StaticResource HubLabel}" Text="{Binding ClanRoleText}"/>
                                                        <TextBlock Margin="10,0,0,0" Style="{StaticResource HubLabel}"
                                                                   Text="{Binding ClanMemberCount, StringFormat={}{0} участников}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource DangerButton}" Height="30" Padding="11,0"
                                                        Content="Покинуть" Command="{Binding LeaveClanCommand}"/>
                                            </Grid>

                                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ClanMembers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="11" Text="{Binding Name}"/>
                                                                <TextBlock Margin="0,1,0,0" Style="{StaticResource HubLabel}" Text="{Binding PresenceText}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource HubLabel}" Text="{Binding RoleText}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasClan}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource HubInput}"
                                                     Text="{Binding ClanSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Название или тег клана"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="36" Padding="13,0"
                                                    Content="Найти" Command="{Binding SearchClansCommand}"/>
                                        </Grid>

                                        <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding ClanSearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6" Style="{StaticResource HubSubCard}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource HubValue}" Text="{Binding DisplayName}"/>
                                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource HubLabel}" Text="{Binding MembersText}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="30" Padding="11,0"
                                                                    Content="Вступить"
                                                                    Command="{Binding DataContext.JoinClanCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource HubCard}">
                                <StackPanel>
                                    <TextBlock Text="Связи" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource HubLabel}"
                                               Text="Друзья, клан и заявки теперь собраны в одной вкладке сообщества."/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Border Style="{StaticResource HubSubCard}" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource HubLabel}" Text="ДРУЗЕЙ"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource HubValue}" FontSize="18" Text="{Binding FriendsCount}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource HubSubCard}" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource HubLabel}" Text="ВХОДЯЩИХ"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource HubValue}" FontSize="18" Text="{Binding IncomingFriendRequestCount}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <!-- Friends -->
                            <Border Style="{StaticResource HubCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Друзья" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Margin="0,4,0,0" Style="{StaticResource HubLabel}"
                                                       Text="{Binding FriendsCount, StringFormat={}{0} друзей}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#8E99AE" FontSize="10"
                                                   Text="{Binding SocialStatusText}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Style="{StaticResource HubLabel}" Margin="1,0,0,4" Text="ПОИСК ПО ДРУЗЬЯМ"/>
                                            <TextBox Style="{StaticResource HubInput}"
                                                     Text="{Binding FriendSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource HubLabel}" Margin="1,0,0,4" Text="ДОБАВИТЬ ПО НИКУ / ID"/>
                                            <TextBox Style="{StaticResource HubInput}"
                                                     Text="{Binding FriendRequestQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <Button Grid.Column="4"
                                                VerticalAlignment="Bottom"
                                                Style="{StaticResource GhostButton}"
                                                Height="36"
                                                Padding="13,0"
                                                Content="Добавить"
                                                Command="{Binding SendFriendRequestCommand}"/>
                                    </Grid>

                                    <ListBox x:Name="FriendsList"
                                             Margin="0,12,0,0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding FilteredFriends}"
                                             ItemContainerStyle="{StaticResource HubListItem}"
                                             MouseDoubleClick="FriendsList_OnMouseDoubleClick"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="38" Height="38"
                                                            CornerRadius="11"
                                                            Background="#202943"
                                                            ClipToBounds="True"
                                                            BorderBrush="#3E4564"
                                                            BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextStrongLocal}"
                                                                       FontWeight="Bold"/>
                                                            <Image Source="{Binding AvatarUrl, IsAsync=True}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="12" Text="{Binding Name}"/>
                                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource HubLabel}" Text="{Binding PresenceText}"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource GhostButton}"
                                                            Height="28"
                                                            Padding="9,0"
                                                            Content="Удалить"
                                                            Command="{Binding DataContext.RemoveFriendCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Friend requests -->
                            <Border Style="{StaticResource HubCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Заявки" Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource HubLabel}" Text="Входящие  "/>
                                            <TextBlock Foreground="{StaticResource TextStrongLocal}" FontSize="11" Text="{Binding IncomingFriendRequestCount}"/>
                                            <TextBlock Margin="12,0,0,0" Style="{StaticResource HubLabel}" Text="Исходящие  "/>
                                            <TextBlock Foreground="{StaticResource TextStrongLocal}" FontSize="11" Text="{Binding OutgoingFriendRequestCount}"/>
                                        </WrapPanel>
                                    </Grid>

                                    <TextBlock Margin="0,12,0,7" Foreground="#B7C0D2" FontWeight="SemiBold" FontSize="11" Text="Входящие"/>
                                    <ItemsControl ItemsSource="{Binding IncomingFriendRequests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Style="{StaticResource HubSubCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource HubValue}" Text="{Binding Name}"/>
                                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource HubLabel}" Text="{Binding PublicId, StringFormat=ID: {0}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Style="{StaticResource GhostButton}" Height="28" Padding="9,0" Margin="0,0,6,0"
                                                                    Content="Принять"
                                                                    Command="{Binding DataContext.AcceptFriendRequestCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource DangerButton}" Height="28" Padding="9,0"
                                                                    Content="Отклонить"
                                                                    Command="{Binding DataContext.DeclineFriendRequestCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Margin="0,10,0,7" Foreground="#B7C0D2" FontWeight="SemiBold" FontSize="11" Text="Исходящие"/>
                                    <ItemsControl ItemsSource="{Binding OutgoingFriendRequests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Style="{StaticResource HubSubCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource HubValue}" Text="{Binding Name}"/>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#B48AF4" FontSize="9" Text="ОЖИДАЕТ"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
