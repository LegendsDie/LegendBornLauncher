<UserControl x:Class="LegendBorn.Views.Tabs.ProfileTabView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:LegendBorn.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="HubCard" TargetType="Border">
            <Setter Property="Background" Value="#C20B0E1A"/>
            <Setter Property="BorderBrush" Value="#34304A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="HubSubCard" TargetType="Border">
            <Setter Property="Background" Value="#88101421"/>
            <Setter Property="BorderBrush" Value="#2D334A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource HubSubCard}">
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="HubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8490A8"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <Style x:Key="HubValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HubInput" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="Background" Value="#A70B0E18"/>
            <Setter Property="BorderBrush" Value="#353A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextStrongLocal}"/>
        </Style>

        <Style x:Key="HubListItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#67101420"
                                BorderBrush="#2C3248"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#9B15192A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#684489"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#A51A1530"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9865D5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#919CB2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="11"
                                Background="#64101420"
                                BorderBrush="#2D334B"
                                BorderThickness="1">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#94161A2B"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#5B3E77"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#E7DAFA"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="#A323163B"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#8052B4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="Transparent"/>
                            <ContentPresenter Grid.Row="2"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profile uses one vertical scroll owner and a launcher-native scrollbar instead of the white Windows default. -->
        <Style x:Key="ProfileScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Margin" Value="4,2,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="38" Background="#76549D">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="#A06DD2"
                                                        BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Account + progression hero -->
        <Border Grid.Row="0"
                CornerRadius="18"
                BorderBrush="#533377"
                BorderThickness="1"
                Padding="16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#18142E" Offset="0"/>
                    <GradientStop Color="#111426" Offset="0.58"/>
                    <GradientStop Color="#0D101D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.12*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.88*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="72" Height="72"
                        CornerRadius="20"
                        ClipToBounds="True"
                        Background="#211B39"
                        BorderBrush="#6B3FA0"
                        BorderThickness="1">
                    <Grid>
                        <TextBlock Text="{Binding UserInitial}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextStrongLocal}"
                                   FontSize="21"
                                   FontWeight="Bold"/>
                        <Image Source="{Binding AvatarUrl, IsAsync=True}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SiteUserName}"
                                   Foreground="{StaticResource TextStrongLocal}"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Margin="10,3,0,0"
                                Padding="8,2"
                                CornerRadius="9"
                                Background="#14281F"
                                BorderBrush="#2F6655"
                                BorderThickness="1">
                            <TextBlock Text="ONLINE" Foreground="#86EFAC" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <WrapPanel Margin="0,8,0,0">
                        <Border Padding="8,4" Margin="0,0,7,0" CornerRadius="9" Background="#70111624" BorderBrush="#303650" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource HubLabel}" Text="MC  "/>
                                <TextBlock Foreground="{StaticResource TextStrongLocal}" FontSize="11" Text="{Binding Username}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="8,4" Margin="0,0,7,0" CornerRadius="9" Background="#70111624" BorderBrush="#303650" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource HubLabel}" Text="РЕЗОН  "/>
                                <TextBlock Foreground="#CBB4FF" FontSize="11" FontWeight="SemiBold"
                                           Text="{Binding Rezonite, StringFormat={}{0:N0}}"/>
                            </StackPanel>
                        </Border>
                        <Border Padding="8,4" CornerRadius="9" Background="#70111624" BorderBrush="#303650" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource HubLabel}" Text="КЛАН  "/>
                                <TextBlock Foreground="{StaticResource TextStrongLocal}" FontSize="11" Text="{Binding ClanName}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <Grid Grid.Column="4" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="УРОВЕНЬ" Style="{StaticResource HubLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                   Text="{Binding ProfileLevel}"
                                   Foreground="#DCCBFF"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="{Binding ProfileXpLevelText}"
                                   Foreground="#8D99B0" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="ProfileXpProgressBar"
                                 Grid.Row="2"
                                 Height="7" Minimum="0" Maximum="100"/>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProfileXpTotal, StringFormat=Всего XP · {0:N0}}"
                                   Foreground="#78859C" FontSize="9"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProfileXpSeason, StringFormat=Сезон · {0:N0}}"
                                   Foreground="#9B86BD" FontSize="9"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Height="34" Padding="12,0" Margin="0,0,7,0"
                            Content="Обновить" Click="RefreshAll_OnClick"/>
                    <Button Style="{StaticResource GhostButton}" Height="34" Padding="12,0" Margin="0,0,7,0"
                            Content="Сайт" Click="OpenSite_OnClick"/>
                    <Button Style="{StaticResource DangerButton}" Height="34" Padding="12,0"
                            Content="Выйти" Click="Logout_OnClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource ProfileTabControl}" SelectedIndex="0">
            <!-- STATUS -->
            <TabItem Header="Статус" Style="{StaticResource ProfileTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ProfileScrollBar}"/>
                    </ScrollViewer.Resources>

                    <Grid Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Server selector / instance context -->
                            <Border Style="{StaticResource HubCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="280"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Сервер" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Статус привязан к выбранному игровому инстансу."
                                                   Style="{StaticResource HubLabel}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Height="36"
                                              ItemsSource="{Binding Servers}"
                                              SelectedItem="{Binding SelectedServer}"
                                              IsEnabled="False"
                                              Foreground="#E6E0F1"
                                              Background="#141827"
                                              BorderBrush="#4A3A62"
                                              BorderThickness="1"
                                              ToolTip="Сейчас доступен один сервер; выбор станет активным при добавлении новых серверов."/>
                                </Grid>
                            </Border>

                            <!-- Live snapshot -->
                            <Border Style="{StaticResource HubCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Состояние персонажа" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding MinecraftStatusStateText}"
                                                       Foreground="#8F9BB0" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MinecraftStatusCapturedText}"
                                                   Foreground="#68758D" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>

                                    <UniformGrid Margin="0,14,0,0" Columns="4">
                                        <Border Style="{StaticResource MetricCard}">
                                            <StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="ЗДОРОВЬЕ"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusHealth}"/></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCard}">
                                            <StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="ГОЛОД"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusFood}"/></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCard}">
                                            <StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="УРОВЕНЬ"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusLevel}"/></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource MetricCard}">
                                            <StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="XP"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusXp}"/></StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.35*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource HubSubCard}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource HubLabel}" Text="МИР / ИЗМЕРЕНИЕ"/>
                                                <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusDimension}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource HubSubCard}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource HubLabel}" Text="ПОЗИЦИЯ"/>
                                                <TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusPosition}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Margin="0,16,0,8" Text="Игровая статистика" Foreground="#B9C2D4" FontSize="11" FontWeight="SemiBold"/>
                                    <UniformGrid Columns="4">
                                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="ВРЕМЯ"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusPlayTime}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="СМЕРТИ"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusDeaths}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="K/D"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusKd}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="УБИЙСТВА"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusTotalKills}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="ИГРОКИ"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusPlayerKills}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="МОБЫ"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusMobKills}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="ПРЫЖКИ"/><TextBlock Margin="0,5,0,0" Style="{StaticResource HubValue}" Text="{Binding MinecraftStatusJumps}"/></StackPanel></Border>
                                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Style="{StaticResource HubLabel}" Text="ПЕШКОМ / ПОЛЁТ"/><TextBlock Margin="0,5,0,0" Foreground="#E4E8F1" FontSize="11"><Run Text="{Binding MinecraftStatusWalk}"/><Run Text="  ·  "/><Run Text="{Binding MinecraftStatusFly}"/></TextBlock></StackPanel></Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 3D skin -->
                        <Border Grid.Column="2" Style="{StaticResource HubCard}" BorderBrush="#523278">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="330"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Текущий образ" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Margin="0,3,0,0" Text="{Binding SelectedSkinTitle}" Style="{StaticResource HubLabel}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="30" Padding="10,0"
                                            Content="Сменить" Command="{Binding OpenSkinManagerCommand}"/>
                                </Grid>
                                <Border Grid.Row="2" CornerRadius="14" Background="#7D080A13" BorderBrush="#37244E" BorderThickness="1" ClipToBounds="True">
                                    <controls:Skin3DView x:Name="ProfileSkin3DPreview"
                                                         SkinUrl="{Binding MinecraftStatusSkinUrl, Mode=OneWay}"/>
                                </Border>
                                <TextBlock Grid.Row="4" HorizontalAlignment="Center"
                                           Text="зажми и потяни, чтобы повернуть"
                                           Foreground="#69768D" FontSize="9"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- COMMUNITY -->
            <TabItem Header="Сообщество" Style="{StaticResource ProfileTabItem}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ProfileScrollBar}"/>
                    </ScrollViewer.Resources>

                    <Grid Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.10*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="0.90*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Friends -->
                            <Border Style="{StaticResource HubCard}" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Друзья" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Margin="0,3,0,0" Style="{StaticResource HubLabel}" Text="{Binding FriendsCount, StringFormat={}{0} друзей}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SocialStatusText}" Foreground="#7F8CA4" FontSize="9" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource HubLabel}" Margin="1,0,0,4" Text="ПОИСК"/>
                                            <TextBox Style="{StaticResource HubInput}" Text="{Binding FriendSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource HubLabel}" Margin="1,0,0,4" Text="НИК / ID"/>
                                            <TextBox Style="{StaticResource HubInput}" Text="{Binding FriendRequestQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <Button Grid.Column="4" VerticalAlignment="Bottom" Style="{StaticResource GhostButton}" Height="34" Padding="12,0"
                                                Content="Добавить" Command="{Binding SendFriendRequestCommand}"/>
                                    </Grid>

                                    <ListBox x:Name="FriendsList"
                                             Margin="0,11,0,0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding FilteredFriends}"
                                             ItemContainerStyle="{StaticResource HubListItem}"
                                             MouseDoubleClick="FriendsList_OnMouseDoubleClick"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="10" Background="#202943" ClipToBounds="True" BorderBrush="#3E4564" BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextStrongLocal}" FontWeight="Bold" FontSize="11"/>
                                                            <Image Source="{Binding AvatarUrl, IsAsync=True}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="11" Text="{Binding Name}"/>
                                                        <TextBlock Margin="0,1,0,0" Style="{StaticResource HubLabel}" Text="{Binding PresenceText}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Height="27" Padding="9,0" Content="Удалить"
                                                            Command="{Binding DataContext.RemoveFriendCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Friend requests -->
                            <Border Style="{StaticResource HubCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Заявки" Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource HubLabel}" Text="Входящие  "/><TextBlock Foreground="#E4E8F1" FontSize="10" Text="{Binding IncomingFriendRequestCount}"/>
                                            <TextBlock Margin="12,0,0,0" Style="{StaticResource HubLabel}" Text="Исходящие  "/><TextBlock Foreground="#E4E8F1" FontSize="10" Text="{Binding OutgoingFriendRequestCount}"/>
                                        </WrapPanel>
                                    </Grid>
                                    <TextBlock Margin="0,11,0,6" Foreground="#B7C0D2" FontWeight="SemiBold" FontSize="10" Text="Входящие"/>
                                    <ItemsControl ItemsSource="{Binding IncomingFriendRequests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Style="{StaticResource HubSubCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Style="{StaticResource HubValue}" Text="{Binding Name}"/><TextBlock Margin="0,2,0,0" Style="{StaticResource HubLabel}" Text="{Binding PublicId, StringFormat=ID: {0}}"/></StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Style="{StaticResource GhostButton}" Height="27" Padding="9,0" Margin="0,0,6,0" Content="Принять" Command="{Binding DataContext.AcceptFriendRequestCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource DangerButton}" Height="27" Padding="9,0" Content="Отклонить" Command="{Binding DataContext.DeclineFriendRequestCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,8,0,6" Foreground="#B7C0D2" FontWeight="SemiBold" FontSize="10" Text="Исходящие"/>
                                    <ItemsControl ItemsSource="{Binding OutgoingFriendRequests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Style="{StaticResource HubSubCard}">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource HubValue}" Text="{Binding Name}"/>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#B48AF4" FontSize="9" Text="ОЖИДАЕТ"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Clan -->
                        <Border Grid.Column="2" Style="{StaticResource HubCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Клан" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource HubLabel}" Text="Состав и управление сообществом."/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ClanStatusText}" Foreground="#7F8CA4" FontSize="9" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Border Margin="0,12,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource HubSubCard}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasClan}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource HubValue}" FontSize="16" Text="{Binding ClanName}"/>
                                                <WrapPanel Margin="0,3,0,0">
                                                    <TextBlock Style="{StaticResource HubLabel}" Text="{Binding ClanTag}"/>
                                                    <TextBlock Margin="9,0,0,0" Style="{StaticResource HubLabel}" Text="{Binding ClanRoleText}"/>
                                                    <TextBlock Margin="9,0,0,0" Style="{StaticResource HubLabel}" Text="{Binding ClanMemberCount, StringFormat={}{0} участников}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Height="28" Padding="10,0" Content="Покинуть" Command="{Binding LeaveClanCommand}"/>
                                        </Grid>
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding ClanMembers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="10" Text="{Binding Name}"/><TextBlock Margin="0,1,0,0" Style="{StaticResource HubLabel}" Text="{Binding PresenceText}"/></StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource HubLabel}" Text="{Binding RoleText}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="0,12,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasClan}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                    </StackPanel.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource HubInput}" Text="{Binding ClanSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Название или тег клана"/>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="34" Padding="12,0" Content="Найти" Command="{Binding SearchClansCommand}"/>
                                    </Grid>
                                    <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding ClanSearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Style="{StaticResource HubSubCard}">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Style="{StaticResource HubValue}" Text="{Binding DisplayName}"/><TextBlock Margin="0,2,0,0" Style="{StaticResource HubLabel}" Text="{Binding MembersText}"/></StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="28" Padding="10,0" Content="Вступить" Command="{Binding DataContext.JoinClanCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
