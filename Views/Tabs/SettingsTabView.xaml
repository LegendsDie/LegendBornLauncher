<UserControl x:Class="LegendBorn.Views.Tabs.SettingsTabView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="980">
    <!-- Distribution contract marker for CI only. BMCLAPI remains an internal fallback and is not shown in Settings. -->
    <UserControl.Resources>
        <Style x:Key="SettingsSection" TargetType="Border">
            <Setter Property="Background" Value="#10000000"/>
            <Setter Property="BorderBrush" Value="#2A3048"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimLocal}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="SettingsValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SettingsCaption" TargetType="TextBlock" BasedOn="{StaticResource SettingsLabel}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongLocal}"/>
            <Setter Property="Background" Value="#12162A"/>
            <Setter Property="BorderBrush" Value="#343B59"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Настройки" Foreground="{StaticResource TextStrongLocal}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextDimLocal}" FontSize="12"
                                   Text="Настройте игру и поведение лаунчера."/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource WinCtlButton}" ToolTip="На главную" Click="OpenStart_OnClick">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.08*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SettingsSection}">
                                    <StackPanel>
                                        <TextBlock Text="Память для Minecraft" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="14"/>
                                        <CheckBox x:Name="AutomaticRamCheck"
                                                  Margin="0,13,0,0" Foreground="{StaticResource TextStrongLocal}"
                                                  Content="Выбирать автоматически"
                                                  IsChecked="{Binding UseAutomaticRam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ComboBox x:Name="RamCombo" Margin="0,12,0,0" Height="44"
                                                  ItemsSource="{Binding RamOptions}"
                                                  SelectedItem="{Binding RamMb, Mode=OneWay}"
                                                  IsEnabled="{Binding ManualRamEnabled}"
                                                  SelectionChanged="RamCombo_OnSelectionChanged"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource SettingsLabel}" Text="УСТАНОВЛЕНО"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingsValue}" Text="{Binding TotalSystemRamMb, StringFormat={}{0:N0} МБ}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource SettingsLabel}" Text="РЕКОМЕНДУЕТСЯ"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingsValue}" Foreground="#CBB4FF"
                                                           Text="{Binding RecommendedRamMb, StringFormat={}{0:N0} МБ}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource SettingsLabel}" Text="ДОСТУПНО"/>
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SettingsValue}" Text="{Binding MaxAllowedRamMb, StringFormat={}{0:N0} МБ}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource SettingsSection}">
                                    <StackPanel>
                                        <TextBlock Text="Java" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Margin="0,4,0,12" Style="{StaticResource SettingsCaption}"
                                                   Text="Для Minecraft 1.21.1 нужна Java 21 (64-bit)."/>

                                        <RadioButton GroupName="JavaMode" Margin="0,4" Foreground="{StaticResource TextStrongLocal}"
                                                     Content="Автоматически" IsChecked="{Binding UseAutomaticJava, Mode=TwoWay}"/>
                                        <TextBlock Margin="24,0,0,7" Style="{StaticResource SettingsLabel}"
                                                   Text="Лаунчер сам найдёт или установит подходящую Java."/>
                                        <RadioButton GroupName="JavaMode" Margin="0,4" Foreground="{StaticResource TextStrongLocal}"
                                                     Content="Использовать установленную Java" IsChecked="{Binding UseSystemJava, Mode=TwoWay}"/>
                                        <RadioButton GroupName="JavaMode" Margin="0,4" Foreground="{StaticResource TextStrongLocal}"
                                                     Content="Выбрать Java вручную" IsChecked="{Binding UseCustomJava, Mode=TwoWay}"/>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource SettingsTextBox}"
                                                     IsEnabled="{Binding JavaCustomPathEnabled}"
                                                     Text="{Binding JavaCustomPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="Выбранная Java"/>
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="40" Padding="13,0"
                                                    IsEnabled="{Binding JavaCustomPathEnabled}"
                                                    Content="Выбрать" Click="SelectJava_OnClick"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SettingsCaption}" Text="{Binding JavaStatusText}"/>
                                            <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource GhostButton}"
                                                    Height="36" Padding="14,0" Content="Проверить" Command="{Binding CheckJavaCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource SettingsSection}">
                                    <StackPanel>
                                        <TextBlock Text="Когда игра запущена" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="14"/>
                                        <RadioButton GroupName="GameUiMode" Margin="0,10,0,4" Foreground="{StaticResource TextStrongLocal}"
                                                     Content="Скрыть лаунчер"
                                                     IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=GameUiModeHide, Mode=TwoWay}"/>
                                        <RadioButton GroupName="GameUiMode" Margin="0,4" Foreground="{StaticResource TextStrongLocal}"
                                                     Content="Свернуть лаунчер"
                                                     IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=GameUiModeMinimize, Mode=TwoWay}"/>
                                        <RadioButton GroupName="GameUiMode" Margin="0,4" Foreground="{StaticResource TextStrongLocal}"
                                                     Content="Оставить открытым"
                                                     IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=GameUiModeNone, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SettingsSection}">
                                    <StackPanel>
                                        <TextBlock Text="Вход и сервер" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="14"/>
                                        <CheckBox Margin="0,14,0,0" Foreground="{StaticResource TextStrongLocal}"
                                                  Content="Входить автоматически"
                                                  IsChecked="{Binding AutoLogin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <CheckBox Margin="0,13,0,0" Foreground="{StaticResource TextStrongLocal}"
                                                  Content="Сразу подключаться к выбранному серверу"
                                                  IsChecked="{Binding AutoConnect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource SettingsSection}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Папка игры" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock x:Name="GameDirectoryText"
                                                       Margin="0,5,0,0" MaxWidth="360" Style="{StaticResource SettingsLabel}"
                                                       Text="{Binding GameDirectoryPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameDirectoryPath}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource GhostButton}"
                                                Height="36" Padding="14,0" Content="Открыть" Command="{Binding OpenGameDirCommand}"/>
                                    </Grid>
                                </Border>

                                <Border Margin="0,14,0,0" Style="{StaticResource SettingsSection}">
                                    <StackPanel>
                                        <TextBlock Text="Обновления" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="14"/>
                                        <Button Margin="0,13,0,0" Style="{StaticResource GhostButton}" Height="42" Padding="16,0"
                                                Content="Проверить обновление лаунчера" Command="{Binding CheckLauncherUpdatesCommand}"/>
                                        <Button x:Name="RepairPackButton"
                                                Margin="0,9,0,0" Style="{StaticResource GhostButton}" Height="42" Padding="16,0"
                                                Content="Проверить файлы игры" Command="{Binding RefreshVersionsCommand}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,14,0,0" Style="{StaticResource SettingsSection}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Помощь и диагностика" Foreground="{StaticResource TextStrongLocal}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Style="{StaticResource SettingsCaption}" Text="Если игра не запускается, создайте отчёт для поддержки."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="Создать отчёт" Command="{Binding CollectDiagnosticsCommand}"
                                                Height="36" Padding="14,0" Margin="0,0,12,0"/>
                                        <CheckBox x:Name="RootAutoScroll" VerticalAlignment="Center" Foreground="{StaticResource TextDimLocal}"
                                                  Content="Следить за новыми строками" IsChecked="True"/>
                                    </StackPanel>
                                </Grid>

                                <Expander Margin="0,12,0,0" Foreground="{StaticResource TextStrongLocal}" Header="Журнал запуска" IsExpanded="False">
                                    <Border Margin="0,10,0,0" Background="#101329" BorderBrush="{StaticResource StrokeGlow}"
                                            BorderThickness="1" CornerRadius="14" Padding="14" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="220"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource GhostButton}" Content="Копировать" Height="34" Padding="14,0"
                                                        Margin="0,0,8,0" Click="CopyLogs_OnClick"/>
                                                <Button Style="{StaticResource GhostButton}" Content="Очистить" Height="34" Padding="14,0" Click="ClearLogs_OnClick"/>
                                            </StackPanel>
                                            <ListBox x:Name="LogListBox" Grid.Row="2" ItemsSource="{Binding LogLines}"
                                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDimLocal}" FontSize="12"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingStackPanel.IsVirtualizing="True"
                                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                     ItemContainerStyle="{StaticResource LogListItemStyle}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextDimLocal}"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
