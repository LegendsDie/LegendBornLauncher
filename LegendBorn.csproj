<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>

        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Fail dependency restore/build on known NuGet advisories. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>

        <!-- App version -->
        <Version>0.3.8</Version>
        <AssemblyVersion>0.3.8.0</AssemblyVersion>
        <FileVersion>0.3.8.0</FileVersion>
        <InformationalVersion>0.3.8</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

        <StartupObject>LegendBorn.App</StartupObject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CmlLib.Core" Version="4.0.6" />
        <PackageReference Include="Velopack" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml" />
        <Page Update="Resources\Themes\LauncherTheme.xaml">
            <Generator>MSBuild:Compile</Generator>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Properties\" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Assets\launcherstart.png" />
        <Resource Include="Resources\Assets\legendcraft.jpg" />
        <Resource Include="Resources\Assets\legendcraft.png" />
        <Resource Include="Resources\Assets\logolauncher.png" />
    </ItemGroup>

</Project>