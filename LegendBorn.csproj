<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>

        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Fail dependency restore/build on known NuGet advisories. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>

        <!-- App version -->
        <Version>0.4.9</Version>
        <AssemblyVersion>0.4.9.0</AssemblyVersion>
        <FileVersion>0.4.9.0</FileVersion>
        <InformationalVersion>0.4.9</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

        <StartupObject>LegendBorn.App</StartupObject>
        <ApplicationIcon>$(IntermediateOutputPath)logolauncher.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CmlLib.Core" Version="4.0.6" />
        <PackageReference Include="Velopack" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ApplicationDefinition Remove="App.xaml" />
        <Page Include="App.xaml" />
        <Page Update="Resources\Themes\LauncherTheme.xaml">
            <Generator>MSBuild:Compile</Generator>
        </Page>
    </ItemGroup>

    <!-- CI smoke-test sources belong to their own project and must never compile into Launcher. -->
    <ItemGroup>
        <Compile Remove="tests\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Properties\" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Assets\launcherstart.png" />
        <Resource Include="Resources\Assets\legendcraft.jpg" />
        <Resource Include="Resources\Assets\legendcraft.png" />
        <Resource Include="Resources\Assets\logolauncher.png" />
    </ItemGroup>

    <Target Name="GenerateLauncherApplicationIcon" BeforeTargets="CoreCompile">
        <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\GenerateLauncherIcon.ps1&quot; -SourcePng &quot;$(MSBuildProjectDirectory)\Resources\Assets\logolauncher.png&quot; -DestinationIco &quot;$(MSBuildProjectDirectory)\$(ApplicationIcon)&quot;" />
    </Target>

</Project>
